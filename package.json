{
  "name": "signbridge-3d",
  "version": "1.0.0",
  "description": "Accessible interactive sign-language learning platform with 3D visualization, speech, practice and communication tools.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b --noCheck false && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "audit:content": "node scripts/content-audit.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "sign-language",
    "asl",
    "isl",
    "accessibility",
    "threejs",
    "react-three-fiber",
    "education",
    "web-speech-api"
  ],
  "author": "SignBridge 3D",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepsh3969/signbridge-3d.git"
  },
  "homepage": "https://signbridge-3d.vercel.app",
  "bugs": {
    "url": "https://github.com/deepsh3969/signbridge-3d/issues"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
